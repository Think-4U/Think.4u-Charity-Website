# Copy this file to .env and fill values before running the app.
# Use long random secrets in production.

# Flask
SECRET_KEY=change-me-to-a-long-random-secret
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Supabase
# Use the service_role key for the Flask backend. Do not expose it in frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SITE_MEDIA_BUCKET=site-media
SUPABASE_TIMEOUT_SECONDS=4

# Upload limits
MAX_UPLOAD_MB=150
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=150
MAX_FORM_MEMORY_MB=16

# Razorpay
RAZOR_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZOR_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# UPI
UPI_VPA=your-upi-id@bank

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=info@example.com

# Meetings
JITSI_MEET_DOMAIN=8x8.vc
JITSI_APP_ID=vpaas-magic-cookie-64fff684dfac45498e265c22c41702e7
JITSI_API_SCRIPT_URL=
JITSI_ROOM_PREFIX=Think4U
JITSI_JWT_KEY_ID=your-jaas-key-id
JITSI_JWT_KID=
JITSI_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JITSI_JWT_PRIVATE_KEY_FILE=
# Self-hosted docker-jitsi-meet normally uses this shared secret with HS256.
# Keep it identical to JWT_APP_SECRET on the Jitsi server and never expose it.
JITSI_JWT_SECRET=
JITSI_JWT_ISSUER=chat
JITSI_JWT_AUDIENCE=jitsi
JITSI_JWT_SUBJECT=vpaas-magic-cookie-your-jaas-app-id
JITSI_JWT_ROOM_CLAIM=
JITSI_JWT_TTL_SECONDS=900
JITSI_REQUIRE_JWT=true
JITSI_ENABLE_E2EE=true
JITSI_DEFAULT_USER_ID=
JITSI_DEFAULT_AVATAR_URL=
JITSI_FEATURE_LIVESTREAMING=false
JITSI_FEATURE_FILE_UPLOAD=false
JITSI_FEATURE_OUTBOUND_CALL=false
JITSI_FEATURE_SIP_OUTBOUND_CALL=false
JITSI_FEATURE_TRANSCRIPTION=false
JITSI_FEATURE_LIST_VISITORS=false
JITSI_FEATURE_RECORDING=false
JITSI_FEATURE_FLIP=false
JITSI_JWT_ALGORITHM=RS256

# Security and Auth
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
ALLOW_DEV_OTP_FALLBACK=false
OTP_EXPIRY_SECONDS=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=90
AUTH_RATE_LIMIT_MAX_REQUESTS=20
INACTIVITY_TIMEOUT_SECONDS=900
PAYMENT_PENDING_TIMEOUT_MINUTES=15
CMS_CACHE_TTL_SECONDS=300

# Cloudflare Turnstile CAPTCHA (Optional in Dev/Fallback, Required in Production)
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key
