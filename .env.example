# Copy this file to .env and fill values before running the app
SECRET_KEY=change-me
SUPABASE_URL=
SUPABASE_KEY=

RAZOR_KEY_ID=
RAZOR_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_VPA=

MAIL_USERNAME=
MAIL_PASSWORD=

# Flags (true/false)
ENFORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
ALLOW_DEV_OTP_FALLBACK=true
ENABLE_ADMIN_BOOTSTRAP=false

# Optional admin bootstrap (when ENABLE_ADMIN_BOOTSTRAP=true)
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional tuning
OTP_EXPIRY_SECONDS=600
CMS_CACHE_TTL_SECONDS=300
# Flask
SECRET_KEY=change-me-to-a-long-random-secret
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database (optional)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Razorpay
RAZOR_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZOR_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# UPI
UPI_VPA=your-upi-id@bank

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=info@example.com

# Security and Auth
OTP_EXPIRY_SECONDS=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=90
AUTH_RATE_LIMIT_MAX_REQUESTS=20
INACTIVITY_TIMEOUT_SECONDS=900
PAYMENT_PENDING_TIMEOUT_MINUTES=15
ALLOW_DEV_OTP_FALLBACK=false
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true

# Bootstrap Admin (disabled by default)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
